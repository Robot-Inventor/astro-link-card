{
  "name": "astro-link-card",
  "version": "5.0.1",
  "description": "Astro integration to automatically convert bare links into link cards.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "./dist/"
  ],
  "type": "module",
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "format": "prettier --write ./src/",
    "format:check": "prettier --check ./src/",
    "lint": "oxlint ./src",
    "version": "npm run build && git add .",
    "ci:version": "changeset version && npm run version",
    "ci:publish": "npm run build && changeset publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Robot-Inventor/astro-link-card.git"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "keywords": [
    "astro",
    "rehype",
    "rehype-plugin",
    "astro-integration",
    "withastro",
    "ui",
    "seo"
  ],
  "author": "Robot-Inventor",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Robot-Inventor/astro-link-card/issues"
  },
  "homepage": "https://github.com/Robot-Inventor/astro-link-card#readme",
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@robot-inventor/oxlint-config": "^0.4.0",
    "@robot-inventor/tsconfig-base": "^7.0.0",
    "astro": "^7.0.0",
    "oxlint": "^1.83.0",
    "prettier": "^3.3.3",
    "typescript": "^7.0.0"
  },
  "dependencies": {
    "rehype-og-card": "^3.0.0"
  }
}
